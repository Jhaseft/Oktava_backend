# ─────────────────────────────────────────
#  Base de datos
# ─────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=disable

# ─────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret

# ─────────────────────────────────────────
#  App
# ─────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────
#  Cloudinary (subida de imágenes)
# ─────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─────────────────────────────────────────
#  Email (SMTP)
# ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Oktava <noreply@oktava.com>"

# ─────────────────────────────────────────
#  Google OAuth
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ─────────────────────────────────────────
#  Niubiz (VisaNet Perú) — Pasarela de pago
# ─────────────────────────────────────────

# Entorno: "sandbox" o "production"
NIUBIZ_ENV=sandbox

# URLs de la API (sandbox)
NIUBIZ_SECURITY_URL=https://apisandbox.vnforappstest.com/api.security/v1/security
NIUBIZ_SESSION_URL=https://apisandbox.vnforappstest.com/api.ecommerce/v2/ecommerce/token/session
NIUBIZ_AUTHORIZATION_URL=https://apisandbox.vnforappstest.com/api.ecommerce/v2/ecommerce/token/authorization

# URLs de la API (producción — descomentar y reemplazar cuando se pase a prod)
# NIUBIZ_SECURITY_URL=https://apiprod.vnforapps.com/api.security/v1/security
# NIUBIZ_SESSION_URL=https://apiprod.vnforapps.com/api.ecommerce/v2/ecommerce/token/session
# NIUBIZ_AUTHORIZATION_URL=https://apiprod.vnforapps.com/api.ecommerce/v2/ecommerce/token/authorization

# Credenciales del comercio
NIUBIZ_MERCHANT_ID=your_merchant_id
NIUBIZ_USER=your_niubiz_user@email.com
NIUBIZ_PASSWORD=your_niubiz_password

# Configuración de transacciones
NIUBIZ_CURRENCY=PEN
NIUBIZ_CHANNEL=web
